# ============================================================
# UniFlow - Backend Environment Configuration
# ============================================================

# Application
APP_NAME=UniFlow API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ============================================================
# PostgreSQL
# ============================================================

# Use the new uniflow_app password generated for Step 2.
# A 64-character hexadecimal password needs no URL encoding.
DATABASE_URL=postgresql+psycopg://uniflow_app:REPLACE_WITH_64_CHAR_HEX_PASSWORD@psql.noveller.org:5432/uniflow?sslmode=require

# Current development setting: encrypt the connection.
# Move to verify-full after client certificate verification
# is configured and tested.
DATABASE_SSL_MODE=require

# ============================================================
# ChromaDB
# ============================================================

CHROMA_HOST=chroma.noveller.org
CHROMA_PORT=443
CHROMA_SSL=true
CHROMA_AUTH_USERNAME=uniflow
CHROMA_AUTH_PASSWORD=REPLACE_WITH_CHROMA_BASIC_AUTH_PASSWORD

# ============================================================
# Redis / Background Jobs
# ============================================================

# For a Redis instance running locally on your laptop.
# When the backend runs in the OCI Docker network, use:
# redis://uniflow-redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Authentication and Security
# ============================================================

# Generate a unique secret for each environment.
# Example generation command:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# ============================================================
# Google Integrations - Configure when implemented
# ============================================================

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ============================================================
# LLM Providers - Configure when implemented
# ============================================================

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
